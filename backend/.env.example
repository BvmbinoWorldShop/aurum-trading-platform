# ===================================================================
# AURUM QUANTITATIVE TRADING ENGINE CONFIGURATION
# ===================================================================

# Security token between mobile app and backend
APP_TOKEN=change-me

# Trading mode: "paper" (demo simulation) or "live" (real broker execution)
TRADING_MODE=paper
PAPER_STARTING_BALANCE=10000.0

# Crypto (Binance via CCXT)
# NOTE: Disable withdrawals on all API keys and enable IP whitelist
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
CRYPTO_QUOTE=USDT

# Forex & Commodities (Gold, Soybeans, Currencies via OANDA v20)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_PRACTICE=true

# US Equities & AI Stocks (Alpaca Markets)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Interactive Brokers (Optional - requires TWS / IB Gateway + ib_async)
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17

# Google Gemini (AI Finance & Human Psychology Agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# GitHub token (Optional - higher rate limits for open-source strategy discovery)
GITHUB_TOKEN=

# Engine parameters
TIMEFRAME=1h
SCAN_INTERVAL_SEC=300
DB_PATH=trading.db
